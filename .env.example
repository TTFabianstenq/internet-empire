# Required. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Neon or any Postgres connection string (serverless-compatible).
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional. Max offline earnings window in hours (default 12).
MAX_OFFLINE_HOURS=12
